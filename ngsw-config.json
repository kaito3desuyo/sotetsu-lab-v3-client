{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-data",
      "urls": [
        "https://api.sotetsu-lab.com/v3/feature-flags",
        "https://api.sotetsu-lab.com/v3/calendar-dates",
        "https://api.sotetsu-lab.com/v3/calendars",
        "https://api.sotetsu-lab.com/v3/formations",
        "https://api.sotetsu-lab.com/v3/services",
        "https://api.sotetsu-lab.com/v3/agencies",
        "https://api.sotetsu-lab.com/v3/routes",
        "https://api.sotetsu-lab.com/v3/stations",
        "https://api.sotetsu-lab.com/v3/trip-classes",
        "https://api.sotetsu-lab.com/v3/trip-blocks",
        "https://api.sotetsu-lab.com/v3/operations/calendar",
        "https://api.sotetsu-lab.com/v3/operations/from",
        "https://api.sotetsu-lab.com/v3/operations/groups",
        "https://api.sotetsu-lab.com/v3/operations/next-operation-candidates",
        "https://api.sotetsu-lab.com/v3/operations/itinerary-links",
        "https://api.sotetsu-lab.com/v3/operations/*/trips"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "7d",
        "maxSize": 50
      }
    },
    {
      "name": "api",
      "urls": ["/api/**"],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "1d",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
